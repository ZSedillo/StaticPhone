  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TaskManager
  jsonResourcePath: Tasks/TaskObjectives
  allTasks:
  - taskId: TASK_FIRST_MATCH
    title: First Spark
    description: Match with your first profile on Dating App.
    isMainStory: 1
    isCompleted: 0
  - taskId: TASK_ONLYYAPS_UNLOCK
    title: Off The Grid
    description: Convince a match to share their private OnlyYaps link.
    isMainStory: 1
    isCompleted: 0
  - taskId: TASK_FIRST_CALL
    title: On The Line
    description: Complete your first voice call on OnlyYaps.
    isMainStory: 1
    isCompleted: 0
  - taskId: TASK_DEEP_CONVO
    title: Under the Surface
    description: Reach the final conversation node on OnlyYaps with anyone.
    isMainStory: 1
    isCompleted: 0
  - taskId: TASK_SILENCE_HANGUP
    title: Lost For Words
    description: Freeze during a call and let them hang up on you.
    isMainStory: 0
    isCompleted: 0
  - taskId: TASK_FUMBLE
    title: Fumbled the Bag
    description: Pick a dialogue choice that derails a conversation.
    isMainStory: 0
    isCompleted: 0
  - taskId: TASK_THREE_CALLS
    title: Social Butterfly
    description: Unlock voice calling with 3 different contacts.
    isMainStory: 0
    isCompleted: 0
